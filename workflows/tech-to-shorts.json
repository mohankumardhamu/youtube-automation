    {
      "id": "f471ffe4-8579-5e9d-9950-5bb52d1f2dd1",
      "name": "Split URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "// Accepts URLs separated by new lines, spaces or commas; drops duplicates and non-http(s) entries.\nconst raw = $input.all().map(i => String(i.json.URLs ?? i.json.urls ?? '')).join('\\n');\nconst urls = [...new Set(\n  raw.split(/[\\s,]+/).map(s => s.trim()).filter(s => /^https?:\\/\\/[^\\s]+$/i.test(s))\n)];\nif (!urls.length) throw new Error('No valid http(s) URLs were provided');\nreturn urls.map(url => ({ json: { url } }));"
      }
    },
    {
      "id": "67f73a91-9735-5e09-966c-88b177c05d4b",
      "name": "Loop Over URLs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        100
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "3b762b9f-e20b-5e8c-a6f7-d643b6bbb0f5",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36"
            },
            {
              "name": "Accept",
              "value": "text/html,application/xhtml+xml"
            }
          ]
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
