# --- n8n ---
N8N_VERSION=stable
GENERIC_TIMEZONE=Asia/Kolkata
# Generated by scripts/setup.sh. Never change it after first start (it encrypts stored credentials).
N8N_ENCRYPTION_KEY=

# --- Claude (script writing) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- VEED avatar video via fal.ai (https://fal.ai/models/veed/avatars/text-to-video) ---
FAL_KEY=
# Vertical (9:16) avatars: emily_vertical_primary, marcus_vertical_primary, mira_vertical_primary,
# jasmine_vertical_primary, elena_vertical_primary, aisha_vertical_walking, any_male_vertical_primary, ...
VEED_AVATAR_ID=emily_vertical_primary

# --- YouTube ---
# private | unlisted | public   (private lets you review each Short before it goes live)
YOUTUBE_PRIVACY=private
# 28 = Science & Technology
YOUTUBE_CATEGORY_ID=28
YOUTUBE_REGION=IN
